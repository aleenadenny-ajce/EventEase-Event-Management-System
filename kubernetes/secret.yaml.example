# ==============================================================================
# EventEase — Kubernetes Secret Example Manifest
# DO NOT commit production secrets with plain-text or base64 passwords to Git.
#
# To create the secret directly via kubectl CLI (Recommended):
#   kubectl create secret generic eventease-secret \
#     --from-literal=SECRET_KEY="your-generated-random-32-byte-secret-key" \
#     -n eventease
#
# Alternatively, to apply using this YAML file:
# 1. Base64 encode your secret:
#      In PowerShell: [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("your-strong-secret-key"))
#      In Linux/Bash: echo -n "your-strong-secret-key" | base64
# 2. Copy this template to kubernetes/secret.yaml
# 3. Paste the resulting base64 string under 'SECRET_KEY:' below
# 4. Apply: kubectl apply -f kubernetes/secret.yaml
# ==============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: eventease-secret
  namespace: eventease
  labels:
    app: eventease
type: Opaque
data:
  # Base64 encoding of: "eventease-k8s-demo-secret-key-2026-production"
  # Generate your own base64 string for actual deployments!
  SECRET_KEY: ZXZlbnRlYXNlLWs4cy1kZW1vLXNlY3JldC1rZXktMjAyNi1wcm9kdWN0aW9u
